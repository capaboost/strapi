{
  "kind": "collectionType",
  "collectionName": "points_question_categories",
  "info": {
    "singularName": "points-question-category",
    "pluralName": "points-question-categories",
    "displayName": "Points Question Category"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "unique": true
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::question-points.question-points",
      "mappedBy": "category"
    }
  }
}
